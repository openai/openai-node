#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

function steady_is_running() {
  curl --silent "http://127.0.0.1:4010/_x-steady/health" >/dev/null 2>&1
}

kill_server_on_port() {
  pids=$(lsof -t -i tcp:"$1" || echo "")
  if [ "$pids" != "" ]; then
    kill "$pids"
    echo "Stopped $pids."
  fi
}

function is_overriding_api_base_url() {
  [ -n "$TEST_API_BASE_URL" ]
}

function has_jest_worker_flag() {
  for arg in "$@"; do
    case "$arg" in
      --runInBand|--runInBand=*|--run-in-band|--run-in-band=*|-i)
        return 0
        ;;
      --maxWorkers|--maxWorkers=*|--max-workers|--max-workers=*|-w|-w?*)
        return 0
        ;;
    esac
  done

  return 1
}

generated_test_patterns=()
while IFS= read -r generated_test_pattern; do
  generated_test_patterns+=("$generated_test_pattern")
done < <(node -e 'for (const pattern of require("./scripts/generated-test-patterns.json")) console.log(pattern)')

function is_generated_test_path() {
  local test_path="$1"
  local generated_test_pattern

  for generated_test_pattern in "${generated_test_patterns[@]}"; do
    case "$test_path" in
      "$generated_test_pattern"|"$generated_test_pattern"/*|*/"$generated_test_pattern"|*/"$generated_test_pattern"/*)
        return 0
        ;;
    esac
  done

  return 1
}

test_suite="${OPENAI_TEST_SUITE:-all}"
vitest_args=()
jest_args=()
has_unit_filter=false
has_generated_filter=false
args=("$@")

for ((index = 0; index < ${#args[@]}; index++)); do
  arg="${args[index]}"

  case "$arg" in
    --)
      ;;
    tests/*|./tests/*|*/tests/*)
      if is_generated_test_path "$arg"; then
        has_generated_filter=true
        jest_args+=("$arg")
      else
        has_unit_filter=true
        vitest_args+=("$arg")
      fi
      ;;
    --runInBand|--runInBand=*|--run-in-band|--run-in-band=*|-i|--showConfig)
      jest_args+=("$arg")
      ;;
    --maxWorkers|--max-workers|-w)
      jest_args+=("$arg")
      vitest_args+=(--maxWorkers)
      if ((index + 1 < ${#args[@]})); then
        ((index += 1))
        jest_args+=("${args[index]}")
        vitest_args+=("${args[index]}")
      fi
      ;;
    --maxWorkers=*|--max-workers=*)
      jest_args+=("$arg")
      vitest_args+=("--maxWorkers=${arg#*=}")
      ;;
    -w?*)
      jest_args+=("$arg")
      worker_count="${arg#-w}"
      vitest_args+=("--maxWorkers=${worker_count#=}")
      ;;
    *)
      vitest_args+=("$arg")
      jest_args+=("$arg")
      ;;
  esac
done

case "$test_suite" in
  unit)
    echo "==> Running handwritten unit tests"
    exec ./node_modules/.bin/vitest run --config vitest.config.mts "${vitest_args[@]}"
    ;;
  all)
    if ! $has_generated_filter || $has_unit_filter; then
      echo "==> Running handwritten unit tests"
      ./node_modules/.bin/vitest run --config vitest.config.mts "${vitest_args[@]}"
    fi

    if $has_unit_filter && ! $has_generated_filter; then
      exit 0
    fi
    ;;
  generated)
    ;;
  *)
    echo "ERROR: Unknown OPENAI_TEST_SUITE: ${OPENAI_TEST_SUITE}. Expected all, generated, or unit." >&2
    exit 1
    ;;
esac

if ! is_overriding_api_base_url && ! steady_is_running ; then
  # When we exit this script, make sure to kill the background mock server process
  trap 'kill_server_on_port 4010' EXIT

  # Start the dev server
  ./scripts/mock --daemon
fi

if is_overriding_api_base_url ; then
  echo -e "${GREEN}✔ Running tests against ${TEST_API_BASE_URL}${NC}"
  echo
elif ! steady_is_running ; then
  echo -e "${RED}ERROR:${NC} The test suite will not run without a mock Steady server"
  echo -e "running against your OpenAPI spec."
  echo
  echo -e "To run the server, pass in the path or url of your OpenAPI"
  echo -e "spec to the steady command:"
  echo
  echo -e "  \$ ${YELLOW}npm exec --package=@stdy/cli@0.22.1 -- steady path/to/your.openapi.yml --host 127.0.0.1 -p 4010 --validator-query-array-format=brackets --validator-form-array-format=brackets --validator-query-object-format=brackets --validator-form-object-format=brackets${NC}"
  echo

  exit 1
else
  echo -e "${GREEN}✔ Mock steady server is running with your OpenAPI spec${NC}"
  echo
fi

echo "==> Running generated tests"

if ! is_overriding_api_base_url && ! has_jest_worker_flag "${jest_args[@]}"; then
  # The local Steady mock server is occasionally flaky under Jest's parallel
  # workers, especially for multipart requests. Keep the default harness stable
  # while allowing callers to opt into explicit worker settings.
  jest_args=(--runInBand "${jest_args[@]}")
fi

OPENAI_TEST_SUITE=generated ./node_modules/.bin/jest "${jest_args[@]}"
