#!/usr/bin/env bash

set -euo pipefail

publish_token=${NPM_TOKEN:-}
export -n publish_token
unset NPM_TOKEN

set +e
bash ./bin/check-npm-version
VERSION_STATUS=$?
set -e
if [[ $VERSION_STATUS -eq 0 ]]; then
  exit 0
elif [[ $VERSION_STATUS -ne 1 ]]; then
  exit "$VERSION_STATUS"
fi

if [[ -z $publish_token && -z ${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-} ]]; then
  echo "ERROR: NPM_TOKEN must be set if not running in a Github Action with id-token permission"
  exit 1
fi

pnpm build

# Install the OIDC-compatible npm before configuring publication credentials.
npm install --prefix oidc/ npm@11.6.2

if [[ -n $publish_token ]]; then
  original_npm_config=$(npm config get userconfig)
  publish_npm_config=''

  cleanup_publish_npm_config() {
    if [[ -n $publish_npm_config ]]; then
      rm -f -- "$publish_npm_config"
    fi
  }
  trap cleanup_publish_npm_config EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  publish_npm_config=$(mktemp "${TMPDIR:-/tmp}/openai-npmrc.XXXXXXXX")
  chmod 600 "$publish_npm_config"
  if [[ -f $original_npm_config && -r $original_npm_config ]]; then
    cp -- "$original_npm_config" "$publish_npm_config"
  fi
  printf '\n//registry.npmjs.org/:_authToken=%s\n' "$publish_token" >> "$publish_npm_config"
  unset publish_token
  export NPM_CONFIG_USERCONFIG="$publish_npm_config"
fi

cd dist

# Get package name and version from package.json
PACKAGE_NAME="$(jq -r -e '.name' ./package.json)"
VERSION="$(jq -r -e '.version' ./package.json)"

# Get latest version from npm
#
# If the package doesn't exist, npm will return:
# {
#   "error": {
#     "code": "E404",
#     "summary": "Unpublished on 2025-06-05T09:54:53.528Z",
#     "detail": "'the_package' is not in this registry..."
#   }
# }
set +e
NPM_INFO="$(npm view "$PACKAGE_NAME" version --json 2>/dev/null)"
NPM_STATUS=$?
set -e

# Check if we got an E404 error
if [[ $NPM_STATUS -eq 0 ]]; then
  LAST_VERSION="$(jq -r -e '.' <<< "$NPM_INFO")"
elif echo "$NPM_INFO" | jq -e '.error.code == "E404"' > /dev/null 2>&1; then
  # Package doesn't exist yet, no last version
  LAST_VERSION=""
else
  echo "ERROR: npm returned unexpected data:"
  echo "$NPM_INFO"
  exit 1
fi

# Check if current version is pre-release (e.g. alpha / beta / rc)
CURRENT_IS_PRERELEASE=false
if [[ "$VERSION" =~ -([a-zA-Z]+) ]]; then
  CURRENT_IS_PRERELEASE=true
  CURRENT_TAG="${BASH_REMATCH[1]}"
fi

# Check if last version is a stable release
LAST_IS_STABLE_RELEASE=true
if [[ -z "$LAST_VERSION" || "$LAST_VERSION" =~ -([a-zA-Z]+) ]]; then
  LAST_IS_STABLE_RELEASE=false
fi

# Use a corresponding alpha/beta tag if there already is a stable release and we're publishing a prerelease.
if $CURRENT_IS_PRERELEASE && $LAST_IS_STABLE_RELEASE; then
  TAG="$CURRENT_TAG"
else
  TAG="latest"
fi

# Publish with the appropriate tag
export npm_config_registry='https://registry.npmjs.org'
../oidc/node_modules/.bin/npm publish --tag "$TAG"
